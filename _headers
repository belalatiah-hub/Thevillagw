# Response headers for the Cloudflare Workers static deploy.
#
# The Content-Security-Policy lives in a <meta> tag inside index.html because
# the page is one self-contained document; everything here is a header that a
# meta tag cannot set. Cloudflare applies these per matching path.

/*
  # Nobody frames this site inside theirs. A clone that wraps the real pages in
  # an iframe under its own domain is the cheapest way to pass this work off as
  # someone else's, and this is the header that stops it.
  X-Frame-Options: SAMEORIGIN

  # A browser must not second-guess a declared content type. Stops a file that
  # is served as an image from being run as a script.
  X-Content-Type-Options: nosniff

  # Send the full URL only to ourselves; other sites learn the origin at most.
  Referrer-Policy: strict-origin-when-cross-origin

  # The site asks for none of these, so nothing embedded in it can either.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # HTTPS only, for a year, subdomains included.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Cross-origin isolation: another origin may not read these responses.
  Cross-Origin-Resource-Policy: same-site
  Cross-Origin-Opener-Policy: same-origin

  # Always revalidate, so a new build reaches visitors on their next load.
  #
  # This has to live on /* rather than only on /index.html, and that is not
  # belt-and-braces. Every page a visitor actually sees — /en/units/OR-ST-01/,
  # /ar/projects/zed-west/ — is the SPA fallback: the request path is the route,
  # never /index.html, so a rule keyed to /index.html matches no real page view.
  # Without this the document was cached with no revalidation, and a unit whose
  # renders had just been added kept showing the placeholder artwork long after
  # the deploy succeeded.
  #
  # The immutable rules below are more specific and still win for the assets
  # they name, so renders, logos and fonts keep their one-year cache.
  Cache-Control: public, max-age=0, must-revalidate

# Renders, floor plans and brochure pages are the costly asset and the one most
# often lifted. same-origin here means another website cannot hotlink them:
# pointing an <img> at these URLs from a different domain gets a blocked
# request, not a free image served off this account's bandwidth.
/project-media/*
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noai, noimageai
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

# The document by its own name, for a direct hit on /index.html.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The editorial dashboard. It holds a session token in localStorage, so it is
# the one page on this origin where a cached copy or an indexed URL would
# actually matter. Never store it, never index it, never frame it.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# NOTE — this file is read by the Cloudflare Workers deploy only. GitHub Pages
# ignores _headers entirely, so if www.thevillageinvestment.com is ever pointed
# at Pages instead of the Worker, every header above silently stops applying:
# the framing block, HSTS, the hotlink protection on /project-media, and this
# revalidation rule. Serve the custom domain from the Worker, or reproduce these
# in front of Pages, before moving the DNS.
