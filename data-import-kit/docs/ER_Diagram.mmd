  %% The Village Investment — real-estate data model (8 entities)
  AREAS {
    id area_id PK
    text name_en
    text name_ar
    slug slug
    enum region
    enum governorate
    text city_en
    text city_ar
    decimal latitude
    decimal longitude
    longtext description_en
    longtext description_ar
    text meta_title_en
    text meta_title_ar
    longtext meta_description_en
    longtext meta_description_ar
    image hero_image
    enum status
    int sort_order
  }
  DEVELOPERS {
    id developer_id PK
    text name_en
    text name_ar
    slug slug
    int founded_year
    text headquarters_en
    text headquarters_ar
    url website
    phone phone
    text tagline_en
    text tagline_ar
    longtext description_en
    longtext description_ar
    image logo_image
    image cover_image
    text meta_title_en
    text meta_title_ar
    longtext meta_description_en
    longtext meta_description_ar
    enum status
    int sort_order
  }
  PROJECTS {
    id project_id PK
    text name_en
    text name_ar
    slug slug
    fk developer_id FK
    fk area_id FK
    enum project_type
    enum project_status
    enum sale_type
    date launch_date
    date delivery_date
    decimal min_price_egp
    decimal max_price_egp
