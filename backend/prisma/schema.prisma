// ═══════════════════════════════════════════════════════════════════════════
// The Village Investment — Enterprise Real Estate CRM
// Data model (Phase 2). Multi-tenant by Company; every business row carries a
// companyId so tenants are isolated at the query layer (see PrismaService +
// TenantContext). Money is stored as integer minor units (piastres/cents) to
// avoid float drift; currency is explicit per row.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Currency {
  EGP
  USD
  AED
  SAR
  EUR
  GBP
}

// System role keys map to a default permission set; permissions themselves are
// fully configurable per company (see Role/Permission tables).
enum SystemRole {
  SUPER_ADMIN
  CEO
  GENERAL_MANAGER
  SALES_DIRECTOR
  SALES_MANAGER
  SUPERVISOR
  TEAM_LEADER
  SENIOR_SALES
  SALES_AGENT
  SALES_ADMIN
  PROPERTY_CONSULTANT
  INSIDE_SALES
  CALL_CENTER
  MARKETING
  MARKETING_MANAGER
  MEDIA_BUYER
  GRAPHIC_DESIGNER
  CUSTOMER_SERVICE
  HR
  FINANCE
  OPERATIONS
  LEGAL
  DEVELOPER_REP
  DEVELOPER_RELATIONS
  CUSTOMER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURING
  MEETING_SET
  NEGOTIATION
  WON
  LOST
  JUNK
}

enum LeadSource {
  WEBSITE
  LANDING_PAGE
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE_ADS
  PROPERTY_FINDER
  DUBIZZLE
  BAYUT
  MANUAL
  QR_CODE
  WHATSAPP
  PHONE_CALL
  IMPORT
  REFERRAL
  OTHER
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

enum UnitType {
  APARTMENT
  VILLA
  TOWNHOUSE
  TWINHOUSE
  DUPLEX
  PENTHOUSE
  STUDIO
  CHALET
  OFFICE
  RETAIL
  CLINIC
  LAND
}

enum ProjectStatus {
  ANNOUNCED
  PRESALE
  UNDER_CONSTRUCTION
  READY
  DELIVERED
  SOLD_OUT
}

enum ActivityType {
  CALL
  MEETING
  WHATSAPP
  EMAIL
  SMS
  NOTE
  SITE_VISIT
  TASK
  STATUS_CHANGE
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
  OVERDUE
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ReservationStatus {
  HELD
  CONVERTED
  CANCELLED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  DUE
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  INSTALLMENT
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum IntegrationProvider {
  META
  FACEBOOK_LEAD_ADS
  INSTAGRAM_LEAD_ADS
  GOOGLE_ADS
  GOOGLE_DRIVE
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  GOOGLE_CONTACTS
  GOOGLE_MAPS
  TIKTOK_LEADS
  TIKTOK_BUSINESS
  WHATSAPP_CLOUD
  SMTP
  TWILIO
  FIREBASE
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  SYNCING
}

enum IntegrationAuthType {
  OAUTH2
  API_KEY
  WEBHOOK
  SMTP_CREDS
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum SyncStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum AutomationTrigger {
  LEAD_CAPTURED
  LEAD_CREATED
}

enum NotificationType {
  LEAD_ASSIGNED
  LEAD_CAPTURED
  SLA_DUE
  FOLLOW_UP_DUE
  OPPORTUNITY_MOVED
  MENTION
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AutomationRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

// ─── Tenancy & identity ──────────────────────────────────────────────────────

model Company {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  baseCurrency Currency @default(EGP)
  timezone     String   @default("Africa/Cairo")
  settings     Json? // flexible tenant prefs: security policy, SLA defaults, branding, locale
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches      Branch[]
  users         User[]
  roles         Role[]
  leads         Lead[]
  customers     Customer[]
  developers    Developer[]
  projects      Project[]
  units         Unit[]
  pipelines     Pipeline[]
  opportunities Opportunity[]
  activities    Activity[]
  auditLogs     AuditLog[]
  reservations  Reservation[]
  contracts     Contract[]
  payments      Payment[]
  commissions   Commission[]
  integrations  Integration[]
  automationRules AutomationRule[]
  automationRuns  AutomationRun[]
  notifications   Notification[]
  departments     Department[]
  positions       Position[]
  teams           Team[]

  @@index([slug])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  leads Lead[]

  @@index([companyId])
}

model User {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  email          String
  passwordHash   String? // null for pure social-login accounts
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  googleId       String?   @unique
  appleId        String?   @unique
  twoFactorEnabled Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  ownedLeads     Lead[]         @relation("LeadOwner")
  ownedCustomers Customer[]     @relation("CustomerOwner")
  activities     Activity[]     @relation("ActivityOwner")
  opportunities  Opportunity[]  @relation("OpportunityOwner")
  commissions    Commission[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  ledTeams       Team[]         @relation("TeamLeader")

  @@unique([companyId, email])
  @@index([companyId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String // argon2 hash of the opaque token — never stored in clear
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── RBAC ────────────────────────────────────────────────────────────────────
// Roles are per-company and carry a bag of permission keys (e.g. "lead:create",
// "unit:update", "report:read"). System roles seed sensible defaults but every
// permission is editable, satisfying "every permission must be configurable".

model Role {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         SystemRole?
  name        String
  description String?
  isSystem    Boolean     @default(false)
  permissions String[] // permission keys — see common/rbac/permissions.ts
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ─── Property catalogue ──────────────────────────────────────────────────────

model Developer {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  logoUrl     String?
  about       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Project {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  developerId  String
  developer    Developer     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  area         String?
  city         String?
  status       ProjectStatus @default(PRESALE)
  description  String?
  latitude     Float?
  longitude    Float?
  amenities    String[]
  coverUrl     String?
  deliveryDate DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  units         Unit[]
  leads         Lead[]
  opportunities Opportunity[]

  @@unique([companyId, slug])
  @@index([companyId, developerId])
}

model Unit {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String // developer/internal unit code
  type         UnitType
  status       UnitStatus @default(AVAILABLE)
  bedrooms     Int?
  bathrooms    Int?
  builtUpArea  Float? // m²
  landArea     Float? // m²
  floor        Int?
  building     String?
  phase        String?
  priceMinor   BigInt // price in minor currency units
  currency     Currency   @default(EGP)
  downPaymentPct Float?
  installmentYears Int?
  images       String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  opportunities Opportunity[]
  reservations  Reservation[]
  contracts     Contract[]

  @@unique([companyId, projectId, code])
  @@index([companyId, status])
}

// ─── People ──────────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId       String?
  owner         User?    @relation("CustomerOwner", fields: [ownerId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String
  altPhone      String?
  nationality   String?
  nationalId    String?
  passportNo    String?
  preferredArea String?
  budgetMinMinor BigInt?
  budgetMaxMinor BigInt?
  currency      Currency @default(EGP)
  bedroomsWanted Int?
  investmentGoal String?
  timeline      String?
  paymentMethod String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads         Lead[]
  activities    Activity[]
  opportunities Opportunity[]
  reservations  Reservation[]
  contracts     Contract[]

  @@index([companyId])
  @@index([companyId, phone])
}

model Lead {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id])
  ownerId       String?
  owner         User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id])

  firstName     String
  lastName      String?
  email         String?
  phone         String
  status        LeadStatus      @default(NEW)
  source        LeadSource      @default(MANUAL)
  temperature   LeadTemperature @default(WARM)
  score         Int             @default(0) // 0–100, computed by LeadScoringService
  interestArea  String?
  budgetMinor   BigInt?
  currency      Currency        @default(EGP)
  message       String?
  lostReason    String?
  wonReason     String?
  aiSummary     String?

  // Source attribution / marketing
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrerUrl   String?
  landingUrl    String?

  // Duplicate detection: normalised phone (digits only, national form)
  phoneNormalized String?
  lastActivityAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  activities    Activity[]
  opportunities Opportunity[]

  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, phoneNormalized])
}

// ─── Pipeline & deals ────────────────────────────────────────────────────────

model Pipeline {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([companyId, name])
  @@index([companyId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  probability Int      @default(0) // 0–100, used for weighted forecast
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)

  opportunities Opportunity[]

  @@index([pipelineId])
}

model Opportunity {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId       String
  stage         PipelineStage     @relation(fields: [stageId], references: [id])
  ownerId       String?
  owner         User?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id])
  unitId        String?
  unit          Unit?             @relation(fields: [unitId], references: [id])

  title         String
  status        OpportunityStatus @default(OPEN)
  valueMinor    BigInt            @default(0)
  currency      Currency          @default(EGP)
  expectedClose DateTime?
  lostReason    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  activities  Activity[]
  reservation Reservation?
  contract    Contract?

  @@index([companyId, pipelineId])
  @@index([companyId, stageId])
}

// ─── Activity timeline (calls, meetings, tasks, notes, status changes) ───────

model Activity {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId       String?
  owner         User?          @relation("ActivityOwner", fields: [ownerId], references: [id])
  type          ActivityType
  status        ActivityStatus @default(PLANNED)
  subject       String
  body          String?
  dueAt         DateTime?
  completedAt   DateTime?

  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, ownerId])
  @@index([companyId, dueAt])
  @@index([leadId])
}

// ─── Audit trail ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "lead.create", "auth.login"
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

// ─── Finance: reservation → contract → installments → payments → commission ──

model Reservation {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit              @relation(fields: [unitId], references: [id])
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  opportunityId String?           @unique
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id])
  status        ReservationStatus @default(HELD)
  depositMinor  BigInt            @default(0)
  currency      Currency          @default(EGP)
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  contract Contract?

  @@index([companyId, status])
}

model Contract {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference      String
  unitId         String
  unit           Unit           @relation(fields: [unitId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  opportunityId  String?        @unique
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  reservationId  String?        @unique
  reservation    Reservation?   @relation(fields: [reservationId], references: [id])
  status         ContractStatus @default(DRAFT)
  totalPriceMinor BigInt
  downPaymentMinor BigInt        @default(0)
  currency       Currency       @default(EGP)
  installmentCount Int           @default(0)
  signedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  installments Installment[]
  payments     Payment[]
  commissions  Commission[]

  @@unique([companyId, reference])
  @@index([companyId, status])
}

model Installment {
  id          String            @id @default(cuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  seq         Int
  dueDate     DateTime
  amountMinor BigInt
  paidMinor   BigInt            @default(0)
  status      InstallmentStatus @default(DUE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  payments Payment[]

  @@unique([contractId, seq])
  @@index([contractId, status])
}

model Payment {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId    String
  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   Installment?  @relation(fields: [installmentId], references: [id])
  amountMinor   BigInt
  currency      Currency      @default(EGP)
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([companyId, contractId])
}

model Commission {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId  String
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  ratePct     Float
  amountMinor BigInt
  currency    Currency         @default(EGP)
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId, status])
  @@index([userId])
}

// ─── Integration Center ──────────────────────────────────────────────────────
// A modular connection to an external provider. Secrets are AES-GCM encrypted
// (secretEnc) and never returned in clear. The CRM core never imports a provider
// directly — it reads the registry + these rows, so integrations can be enabled
// or disabled without touching core code.

model Integration {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  name        String
  status      IntegrationStatus   @default(DISCONNECTED)
  authType    IntegrationAuthType
  enabled     Boolean             @default(false)
  // Non-secret configuration (account ids, page ids, form ids, endpoints…).
  config      Json?
  // Encrypted credential bundle (OAuth tokens / api key / webhook secret).
  secretEnc   String?
  // Last 4 chars of the key for display only.
  secretHint  String?
  webhookUrl  String?
  webhookSecret String?
  lastSyncAt  DateTime?
  lastError   String?
  health      Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  syncLogs IntegrationSyncLog[]

  @@unique([companyId, provider])
  @@index([companyId, status])
}

model IntegrationSyncLog {
  id            String        @id @default(cuid())
  integrationId String
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  direction     SyncDirection
  status        SyncStatus
  summary       String
  records       Int           @default(0)
  attempts      Int           @default(1)
  error         String?
  createdAt     DateTime      @default(now())

  @@index([integrationId, createdAt])
}

// ─── Automation Engine ───────────────────────────────────────────────────────
// Rules-based workflows. On a trigger (e.g. a lead is captured) the engine
// evaluates each enabled rule's conditions and runs its actions: assign
// (round-robin), create a follow-up, start an SLA timer, send a WhatsApp
// template (via the Integration Center), and generate an AI summary. Modular:
// actions/conditions are JSON, so new behaviour needs no schema change.

model AutomationRule {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  trigger    AutomationTrigger @default(LEAD_CAPTURED)
  enabled    Boolean           @default(true)
  order      Int               @default(0)
  conditions Json? // { source?: string[], temperature?: string[], minScore?: number, area?: string[] }
  actions    Json // [{ type, minutes?, userId?, template? }]
  runCount   Int               @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  runs AutomationRun[]

  @@index([companyId, enabled])
}

model AutomationRun {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadId    String?
  status    AutomationRunStatus
  actions   Json // executed action results
  error     String?
  createdAt DateTime            @default(now())

  @@index([companyId, createdAt])
  @@index([ruleId])
}

model Notification {
  id         String               @id @default(cuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType     @default(SYSTEM)
  priority   NotificationPriority @default(NORMAL)
  title      String
  body       String?
  data       Json? // { leadId?, opportunityId?, url? } — deep-link payload
  entityType String? // "lead" | "opportunity" | "activity" | ...
  entityId   String?
  read       Boolean              @default(false)
  readAt     DateTime?
  pushedAt   DateTime? // when an FCM push was dispatched (null = in-app only)
  createdAt  DateTime             @default(now())

  @@index([companyId, userId, read])
  @@index([userId, createdAt])
}

// ─── Organizational structure (departments, positions, teams) ────────────────

model Department {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions Position[]
  teams     Team[]
  users     User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Position {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title        String
  level        Int         @default(0) // seniority ordering
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users User[]

  @@unique([companyId, title])
  @@index([companyId])
}

model Team {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  leaderId     String?
  leader       User?       @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members User[] @relation("TeamMembers")

  @@unique([companyId, name])
  @@index([companyId])
}
